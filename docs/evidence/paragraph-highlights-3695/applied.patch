+                        (1..8, TextMark::default().italic()),
+                        (4..8, TextMark::default().code()),
+                    ]),
+                    InlineNode::new("文b").marks(vec![
+                        (0..4, TextMark::default().link(link.clone())),
+                        (0..3, TextMark::default().bold()),
